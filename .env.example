# Copy to .env and fill in. NEVER commit the real .env file.

# --- Required -------------------------------------------------------------
# OpenAI key used by the chatbot (model is fixed: gpt-4o-mini)
OPENAI_API_KEY=
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=production; optional in development (random per start).
SECRET_KEY=

# --- Environment ----------------------------------------------------------
# production (default, safest) | development | testing
APP_ENV=development
LOG_LEVEL=INFO

# --- Server (python -m api) -------------------------------------------------
FLASK_RUN_HOST=127.0.0.1
PORT=5000
# Debug is refused when APP_ENV=production
FLASK_DEBUG=false

# --- Database -----------------------------------------------------------------
# Relative paths are resolved from the project root
DATABASE_PATH=banco.db

# --- CORS and session cookie ----------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# Development default: http://localhost:8080 and http://127.0.0.1:8080 (and :5500)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Lax works when frontend and API share a site (same host, any port).
# Use None (requires SESSION_COOKIE_SECURE=true) only if they are on different domains.
SESSION_COOKIE_SAMESITE=Lax
# Defaults to true in production, false otherwise
SESSION_COOKIE_SECURE=false
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = none)
PROXY_FIX_X_FOR=0

# --- Cost controls (OpenAI is a paid API) -------------------------------------
# Max previous messages (questions + answers) sent to the model per request
HISTORY_MAX_MESSAGES=10
# Max characters accepted in one user message
MAX_MESSAGE_CHARS=2000
# Max tokens the model may generate per answer
LLM_MAX_TOKENS=1024

# --- Validation and rate limiting ---------------------------------------------
MIN_PASSWORD_LENGTH=8
# Flask-Limiter syntax. /mensagem is limited per authenticated user.
RATE_LIMIT_LOGIN=5 per minute;30 per hour
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_MESSAGE=10 per minute;200 per day
# Use e.g. redis://redis:6379 to share limits across several workers
RATELIMIT_STORAGE_URI=memory://

# Log format: text (default) or json (one JSON object per line)
LOG_FORMAT=text
# Seconds to wait for the OpenAI API before giving up
LLM_TIMEOUT_SECONDS=30
